# Mongo Database Configuration
MONGO_USER=shortlist
MONGO_PASSWORD=shortlist_secure_dev_pass_123
MONGO_DB=shortlist

# Database Connection URI
MONGODB_URI=mongodb://shortlist:shortlist_secure_dev_pass_123@db:27017/shortlist?authSource=admin

# JWT Authentication (Secrets must be at least 32 characters long)
JWT_ACCESS_SECRET=shortlist_super_secret_jwt_access_token_key_at_least_32_characters
JWT_REFRESH_SECRET=shortlist_super_secret_jwt_refresh_token_key_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Provider ("mock" or "gemini")
AI_PROVIDER=mock
GEMINI_API_KEY=dummy_mock_key_for_testing
GEMINI_MODEL=gemini-1.5-flash

# Application Ports & URLs
PORT=3000
FRONTEND_PORT=5173
CORS_ORIGIN=http://localhost:5173
NODE_ENV=production

# File Upload Configuration
MAX_CV_SIZE_MB=5
UPLOAD_DIR=/app/uploads/cvs
